{
  "name": "stax",
  "version": "2.0.0",
  "private": true,
  "description": "Build tools for the Stax WordPress theme. Not part of the theme zip.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node bin/build.mjs",
    "build:css": "node bin/build.mjs css",
    "build:js": "node bin/build.mjs js",
    "pot": "wp i18n make-pot . languages/stax.pot --exclude=node_modules,dist,bin,docs,inc/Customizer/core/controls/react/src,inc/Customizer/metabox/src",
    "zip": "sh bin/make-zip.sh"
  },
  "devDependencies": {
    "cssnano": "^7.0.6",
    "esbuild": "^0.25.0",
    "glob": "^11.0.0",
    "postcss": "^8.4.49",
    "purgecss": "^6.0.0",
    "rtlcss": "^4.3.0",
    "sass": "^1.80.0"
  }
}
